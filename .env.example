# Meta Conversions API (CAPI) — server-side, double le pixel client
# Sans CAPI, Meta Advantage+ dégrade les campagnes (surtout CTWA) en 2026
META_PIXEL_ID=...
META_CAPI_ACCESS_TOKEN=...
# META_TEST_EVENT_CODE=TEST12345  # optionnel, uniquement pour tests

# TikTok Pixel + Events API — même principe que Meta ci-dessus, canal séparé.
# Sans ces 3 variables, TikTokPixel.tsx ne charge rien et sendTikTokEvent() est
# fail-open (jamais d'erreur, juste aucune donnée collectée). Aucun ID n'existe
# encore : à créer dans TikTok Ads Manager > Assets > Events > Web Events.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=...
TIKTOK_PIXEL_ID=...
# Même valeur que NEXT_PUBLIC_TIKTOK_PIXEL_ID ci-dessus — dupliquée volontairement :
# la version NEXT_PUBLIC_ est exposée au navigateur (pixel client), celle-ci reste
# serveur (Events API). Même "Pixel Code", copié aux deux endroits.
TIKTOK_CAPI_ACCESS_TOKEN=...

# ── Gardes des routes qui COÛTENT DE L'ARGENT (src/lib/api-guard.ts) ──────────
# Ajoutés le 14/08/2026 après avoir mesuré que /api/diagnostic répondait 200 à
# n'importe qui en production, publiait les 23 noms de variables du serveur + le
# préfixe de la clé Anthropic, et déclenchait un vrai appel Anthropic + Pieuvre
# à CHAQUE visite (4 583 ms). Les deux jetons sont FAIL CLOSED : non définis =
# route fermée (404). Ne rien définir est donc l'état SÛR, pas l'état cassé.

# Outil de diagnostic interne. Sans lui, /api/diagnostic renvoie 404 à tout le
# monde. Chaîne aléatoire ≥ 32 caractères. Ex. : openssl rand -hex 24
DIAGNOSTIC_TOKEN=

# Pont LLM serveur-à-serveur (/api/ajnaya/chat/completions), prévu pour un agent
# vocal ElevenLabs « Custom LLM ». Sans lui, la route renvoie 404 — c'est voulu :
# elle était un proxy Claude gratuit ouvert sur Internet, facturé à FOREAS.
# Pour rebrancher un agent : définir cette variable ICI **et** coller la MÊME
# valeur dans ElevenLabs → Custom LLM → API Key. Les deux, sinon 404.
AJNAYA_LLM_TOKEN=

